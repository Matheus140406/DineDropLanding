# Endereço da landing, usado em canonical, Open Graph, JSON-LD, robots.txt e sitemap.xml. Sem ele: https://www.dinedrop.com.br.
VITE_SITE_URL=https://www.dinedrop.com.br
# Endereço do app (painel, Termos, Privacidade). Sem ele: https://appdinedrop.com.
VITE_APP_URL=https://appdinedrop.com
# Cardápio de exemplo da seção "Teste agora" (o QR é gerado no build). Padrão: https://appdinedrop.com/devteam2026tech
# VITE_DEMO=https://appdinedrop.com/devteam2026tech
# Opcional: um QR próprio por vertente (vazio = a vertente fica só com o texto)
# VITE_DEMO_MESA=
# VITE_DEMO_DELIVERY=
# VITE_DEMO_BALCAO=
