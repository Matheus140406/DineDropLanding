# Endereço da landing, usado em canonical, Open Graph, JSON-LD, robots.txt e sitemap.xml. Sem ele: https://www.dinedrop.com.br.
VITE_SITE_URL=https://www.dinedrop.com.br
# Endereço do app (painel, Termos, Privacidade). Sem ele: https://appdinedrop.com.
VITE_APP_URL=https://appdinedrop.com
# Cardápios de exemplo da seção "Teste agora" (o QR é gerado no build). Vazio = espaço reservado, sem QR.
# VITE_DEMO_MESA=https://appdinedrop.com/mexico
# VITE_DEMO_DELIVERY=https://appdinedrop.com/<cardapio-de-exemplo-delivery>
# VITE_DEMO_BALCAO=https://appdinedrop.com/<cardapio-de-exemplo-balcao>
